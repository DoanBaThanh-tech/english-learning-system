{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "Skyword",
    "Audience": "SkywordClient",
    "Key": "",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 30
  },
  "Ai": {
    "Enabled": false,
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "ApiKey": "",
    "Model": "gemini-2.5-flash",
    "TimeoutSeconds": 45
  },
  "ExternalApis": {
    "TimeoutSeconds": 15,
    "UserAgent": "Skyword/1.0 (personal English learning app)",
    "EnableTranslation": true,
    "EnableDictionary": true
  },
  "Seed": {
    "DemoUser": false
  },
  "AllowedHosts": "*"
}
